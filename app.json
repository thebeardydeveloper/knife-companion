{
  "expo": {
    "name": "KnifeCompanion",
    "slug": "KnifeCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.tbd.knifecompanion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tbd.knifecompanion"
    },
    "android": {
      "package": "com.tbd.knifecompanion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F2EE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "KnifeCompanion needs access to your photos to let you share your knife making work.",
          "cameraPermission": "KnifeCompanion needs camera access to take photos of your knife making work."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26515134-2b30-4b14-a108-d6fb6c288634"
      }
    }
  }
}

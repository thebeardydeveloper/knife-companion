{
  "expo": {
    "name": "KnifeCompanion",
    "slug": "KnifeCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.thebeardydev.knifecompanion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "The ultimate reference app for knife makers and enthusiasts. Explore 50+ steels with full composition, properties, and heat treatment guides. Share your work, discover other makers, and connect with the knife making community.",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#393737"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebeardydev.knifecompanion",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "KnifeCompanion needs access to your photos to let you share your knife making work.",
        "NSCameraUsageDescription": "KnifeCompanion needs camera access to take photos of your knife making work."
      }
    },
    "android": {
      "package": "com.thebeardydev.knifecompanion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#393737"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "KnifeCompanion needs access to your photos to let you share your knife making work.",
          "cameraPermission": "KnifeCompanion needs camera access to take photos of your knife making work."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C4822A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26515134-2b30-4b14-a108-d6fb6c288634"
      }
    }
  }
}
